# Hevy API key from https://hevy.com/settings?developer (requires Hevy Pro)
HEVY_API_KEY=

# Garmin Connect login
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional tuning
# How many days back flow B looks each run
GH_LOOKBACK_DAYS=14
# How many days back flow D looks for weigh-ins. Much longer than the flow B
# window on purpose: weigh-ins are sparse, and one that falls out of the window
# is never picked up again rather than merely being picked up late
GH_BODY_LOOKBACK_DAYS=365
# A Garmin activity this close to an existing Hevy workout is treated as the
# same session and left alone by flow B
GH_OVERLAP_MINUTES=45
# Minimum similarity for a Garmin exercise to bind to a Hevy template
GH_MATCH_THRESHOLD=0.55
