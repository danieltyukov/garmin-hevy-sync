[Unit]
Description=Sync workouts between Garmin Connect and Hevy
Documentation=file://@REPO@/README.md
# Both APIs are remote, so there is no point starting before the network is up.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart=@REPO@/bin/sync-all.sh
# A sync normally takes well under a minute; anything past this is wedged.
TimeoutStartSec=1800
# Garmin rate-limits aggressively. Back off rather than hammering on failure.
Restart=no
StandardOutput=journal
StandardError=journal
