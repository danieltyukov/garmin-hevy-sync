[Unit]
Description=Periodic Garmin <-> Hevy sync
Documentation=file://@REPO@/README.md

[Timer]
# First run shortly after login/boot, then every 30 minutes.
OnStartupSec=3min
OnUnitActiveSec=30min
# Catch up on a run missed while the machine was asleep or powered off.
Persistent=true
# Every user on the planet schedules on the hour; spread the load so Garmin
# does not see a thundering herd.
RandomizedDelaySec=5min
AccuracySec=1min
Unit=garmin-hevy-sync.service

[Install]
WantedBy=timers.target
